# Kunci API dari WeatherAPI.com (gratis di weatherapi.com)
WEATHERAPI_KEY=kunci_api_weatherapi_anda

# URL Project Supabase (contoh: https://abcdef.supabase.co)
SUPABASE_URL=https://project-id-anda.supabase.co

# Anon/Public key Supabase (digunakan oleh Dashboard untuk read-only)
SUPABASE_KEY=anon-public-key-supabase-anda

# Service Role key Supabase (digunakan oleh ETL Pipeline untuk write access)
# Dapatkan dari: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_KEY=service-role-key-supabase-anda
